{
    "name": "xct-studio",
    "version": "2.0.0",
    "private": true,
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "check:harness": "node scripts/check-harness.ts",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
        "gallery:upload": "node scripts/upload-gallery.mjs",
        "preinstall": "node scripts/require-pnpm.ts",
        "postinstall": "node scripts/copy-ffmpeg-core.mjs",
        "bench": "vitest bench --run",
        "db:migrate": "node --conditions=react-server scripts/migrate-database.ts"
    },
    "dependencies": {
        "@ffmpeg/ffmpeg": "0.12.15",
        "@ffmpeg/util": "0.12.2",
        "@radix-ui/react-checkbox": "^1.3.2",
        "@radix-ui/react-dialog": "^1.1.11",
        "@radix-ui/react-label": "^2.1.4",
        "@radix-ui/react-radio-group": "^1.3.4",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slider": "^1.3.2",
        "@radix-ui/react-slot": "^1.2.0",
        "@radix-ui/react-tabs": "^1.1.9",
        "@radix-ui/react-toggle": "^1.1.6",
        "@radix-ui/react-toggle-group": "^1.1.7",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/vite": "^4.1.4",
        "artplayer": "5.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.0.11",
        "dexie-react-hooks": "^1.1.7",
        "lucide-react": "^0.503.0",
        "mammoth": "^1.12.2",
        "mime-types": "^3.0.1",
        "next": "16.3.4",
        "next-intl": "4.14.2",
        "next-themes": "^0.4.6",
        "openai": "^6.2.0",
        "pdf-parse": "^2.4.5",
        "pdfjs-dist": "5.4.296",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "0.0.1",
        "tailwind-merge": "^3.2.0",
        "word-extractor": "^1.0.4"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "^5.7.1",
        "@eslint/eslintrc": "^3",
        "@ffmpeg/core": "0.12.10",
        "@tailwindcss/postcss": "^4",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/mime-types": "^2.1.4",
        "@types/node": "^22.20.1",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/word-extractor": "^1.0.6",
        "cross-env": "^10.1.0",
        "dotenv": "^17.2.3",
        "eslint": "^9",
        "eslint-config-next": "16.3.4",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "sass": "^1.104.0",
        "tailwindcss": "^4.1.4",
        "tw-animate-css": "^1.2.8",
        "typescript": "^5",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=22.18.0",
        "pnpm": "10.34.5"
    }
}
