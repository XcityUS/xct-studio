# ── Gateway ──────────────────────────────────────────────────────────────
# TokenHub (LiteLLM) gateway origin that serves the OpenAI-style /v1 API.
# The user's key authenticates model calls; script breakdown uses a same-origin server route.
# NEXT_PUBLIC_OPENAI_API_BASE_URL=https://tokenhub.xcity.one/v1
# SCRIPT_BREAKDOWN_MODEL=gpt-5-mini
# Server-only gateway origin used by provider asset route handlers.
# XCITY_LITELLM_URL=https://tokenhub.xcity.one
# Set true when the gateway provider asset routes and credentials are deployed.
# PROVIDER_ASSETS_ENABLED=true

# ── Xcity SSO (unified key) ──────────────────────────────────────────────
# When true, the studio fetches the signed-in user's TokenHub key from
# xcity.ai (requires the xcity.ai CORS allowlist to include this origin).
# When false/unset, users paste a key manually.
# NEXT_PUBLIC_XCITY_SSO=true
# NEXT_PUBLIC_XCITY_KEY_URL=https://xcity.ai/api/me/litellm-key
# NEXT_PUBLIC_XCITY_LOGIN_URL=https://xcity.ai/login

# ── Media archive (Cloudflare R2 via media-worker/) ──────────────────────
# Origin of the deployed xcity-media worker. Read server-side per request via
# /api/config, so it takes effect on restart — no rebuild needed. Leave unset
# to disable archiving (videos then rely on the provider's 24h CDN links).
# MEDIA_WORKER_URL=https://media.xcity.ai

# ── Image generation ─────────────────────────────────────────────────────
# Comma-separated TokenHub image model ids. Read server-side per request via
# /api/config, so it takes effect on restart — no rebuild needed. Leave unset
# to hide the Image tab.
# IMAGE_MODELS=seedream-5-0-260128
